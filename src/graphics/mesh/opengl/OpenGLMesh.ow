module Graphics.OpenGLMesh: GRAPHICS_MESH
  fn name() -> string:
    return: "mesh"
  fn requires() -> array:
    return: ["window"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create(positions array) -> int:
    return: extension("graphics.mesh.create", positions)
  fn create_indexed(positions array, uvs array, indices array) -> int:
    return: extension("graphics.mesh.create_indexed", positions, uvs, indices)
  fn destroy(handle int) -> int:
    return: extension("graphics.mesh.destroy", handle)
