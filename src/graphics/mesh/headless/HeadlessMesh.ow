# A deliberately small contract fake. GPU resource lifetime is tested in Java.
module Graphics.HeadlessMesh: GRAPHICS_MESH
  fn name() -> string:
    return: "mesh"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create(positions array) -> int:
    if: len(positions) < 9
      return: 0
    return: 1
  fn create_indexed(positions array, uvs array, indices array) -> int:
    if: len(positions) < 9
      return: 0
    if: len(uvs) * 3 != len(positions) * 2
      return: 0
    if: len(indices) < 3
      return: 0
    return: 1
  fn create_lit_indexed(positions array, uvs array, normals array, indices array) -> int:
    if: len(normals) != len(positions)
      return: 0
    if: len(positions) < 9
      return: 0
    if: len(uvs) * 3 != len(positions) * 2
      return: 0
    if: len(indices) < 3
      return: 0
    return: 1
  fn create_skinned_indexed(positions array, uvs array, normals array, indices array, joints array, weights array) -> int:
    if: len(positions) < 9
      return: 0
    if: len(normals) != len(positions)
      return: 0
    if: len(uvs) * 3 != len(positions) * 2
      return: 0
    if: len(joints) * 3 != len(positions) * 4
      return: 0
    if: len(weights) != len(joints)
      return: 0
    if: len(indices) < 3
      return: 0
    return: 1
  fn draw_instanced(handle int, modelMatrices array) -> int:
    if: handle < 1
      return: 0
    if: len(modelMatrices) == 0
      return: 0
    set i int: 0
    while: i < len(modelMatrices)
      if: len(modelMatrices[i]) != 16
        return: 0
      set i: i + 1
    return: 1
  fn destroy(handle int) -> int:
    if: handle < 1
      return: 0
    return: 1
