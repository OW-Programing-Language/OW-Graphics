module Graphics.GlfwInput: GRAPHICS_INPUT
  fn name() -> string:
    return: "input"
  fn requires() -> array:
    return: ["window"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn escape_pressed() -> int:
    return: extension("graphics.input.escape")
