module Graphics.GlfwInput: GRAPHICS_INPUT
  fn name() -> string:
    return: "input"
  fn requires() -> array:
    return: ["window"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn escape_pressed() -> int:
    return: extension("graphics.input.escape")
  fn key_down(key string) -> int:
    return: extension("graphics.input.key_down", key)
  fn cursor_delta() -> array:
    return: extension("graphics.input.cursor_delta")
  fn scroll_delta() -> float:
    return: extension("graphics.input.scroll_delta")
