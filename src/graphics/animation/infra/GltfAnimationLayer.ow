# CPU-only additive skeletal layer: no GL context or persistent handles.
module Graphics.GltfAnimationLayer: GRAPHICS_ANIMATION_LAYER
  fn name() -> string:
    return: "animation_layer"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn additive(library array, baseClip int, baseSeconds float, layerClip int, layerSeconds float, referenceSeconds float, weight float, nodeMask array) -> array:
    return: extension("graphics.animation.layer.additive", library, baseClip, baseSeconds, layerClip, layerSeconds, referenceSeconds, weight, nodeMask)
