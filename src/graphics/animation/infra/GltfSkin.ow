# Rig import + time sampling are CPU-only Java SPI calls; the OW app owns
# the rig array and explicitly uploads bone matrices to a chosen shader.
module Graphics.GltfSkin: GRAPHICS_GLTF_SKIN
  fn name() -> string:
    return: "gltf_skin"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn parse_rig(gltfJson string) -> array:
    return: extension("graphics.skin.parse_gltf", gltfJson)
  fn load_rig(relativePath string) -> array:
    return: extension("graphics.skin.load_gltf", relativePath)
  fn sample_palette(rig array, time float) -> array:
    return: extension("graphics.skin.sample", rig, time)
