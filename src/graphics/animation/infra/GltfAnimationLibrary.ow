# CPU-only Java bridge for glTF clip decoding/sampling.
# Library arrays remain owned by the OW application; no persistent Java handle.
module Graphics.GltfAnimationLibrary: GRAPHICS_ANIMATION_LIBRARY
  fn name() -> string:
    return: "animation_library"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn load_library(relativePath string) -> array:
    return: extension("graphics.animation.library.load", relativePath)
  fn parse_library(gltfJson string) -> array:
    return: extension("graphics.animation.library.parse", gltfJson)
  fn clip_duration(library array, clip int) -> float:
    return: extension("graphics.animation.library.duration", library, clip)
  fn loop_time(library array, clip int, seconds float) -> float:
    return: extension("graphics.animation.library.loop", library, clip, seconds)
  fn sample_clip(library array, clip int, seconds float) -> array:
    return: extension("graphics.animation.library.sample", library, clip, seconds)
  fn blend_clips(library array, sourceClip int, sourceTime float, destinationClip int, destinationTime float, weight float) -> array:
    return: extension("graphics.animation.library.blend", library, sourceClip, sourceTime, destinationClip, destinationTime, weight)
