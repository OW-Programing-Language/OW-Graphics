# No GPU required. Uses JVM System.nanoTime(), a monotonic source.
module Graphics.MonotonicClock: GRAPHICS_ANIMATION_CLOCK
  fn name() -> string:
    return: "clock"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn now_seconds() -> float:
    return: extension("graphics.animation.clock.now_seconds")
