# One shader domain; flOW ensures the window service starts first.
module Graphics.OpenGLShader: GRAPHICS_SHADER
  fn name() -> string:
    return: "shader"
  fn requires() -> array:
    return: ["window"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create(vertexSource string, fragmentSource string) -> int:
    return: extension("graphics.shader.create", vertexSource, fragmentSource)
  fn bind(handle int) -> int:
    return: extension("graphics.shader.bind", handle)
  fn set_vec4(handle int, name string, r float, g float, b float, a float) -> int:
    return: extension("graphics.shader.uniform4", handle, name, r, g, b, a)
  fn set_mat4(handle int, name string, values array) -> int:
    return: extension("graphics.shader.uniform_mat4", handle, name, values)
  fn set_mat4_array(handle int, name string, matrices array) -> int:
    return: extension("graphics.shader.uniform_mat4_array", handle, name, matrices)
  fn set_int(handle int, name string, value int) -> int:
    return: extension("graphics.shader.uniform_int", handle, name, value)
  fn destroy(handle int) -> int:
    return: extension("graphics.shader.destroy", handle)
