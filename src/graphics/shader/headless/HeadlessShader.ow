# Contract-compatible no-GPU shader for flOW integration tests.
# Does not parse GLSL: this is intentionally not a GLSL validator.
module Graphics.HeadlessShader: GRAPHICS_SHADER
  fn name() -> string:
    return: "shader"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create(vertexSource string, fragmentSource string) -> int:
    if: len(vertexSource) < 1
      return: 0
    if: len(fragmentSource) < 1
      return: 0
    return: 1
  fn bind(handle int) -> int:
    if: handle < 1
      return: 0
    return: 1
  fn set_vec4(handle int, name string, r float, g float, b float, a float) -> int:
    if: handle < 1
      return: 0
    if: len(name) < 1
      return: 0
    return: 1
  fn set_mat4(handle int, name string, values array) -> int:
    if: handle < 1
      return: 0
    if: len(values) != 16
      return: 0
    return: 1
  fn set_mat4_array(handle int, name string, matrices array) -> int:
    if: handle < 1
      return: 0
    if: len(matrices) < 1
      return: 0
    if: len(matrices) > 32
      return: 0
    set i int: 0
    while: i < len(matrices)
      if: len(matrices[i]) != 16
        return: 0
      set i: i + 1
    return: 1
  fn set_int(handle int, name string, value int) -> int:
    if: handle < 1
      return: 0
    return: 1
  fn destroy(handle int) -> int:
    if: handle < 1
      return: 0
    return: 1
