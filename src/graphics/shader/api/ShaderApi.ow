# OpenGL shader programs are opaque int handles owned by the current window.
# No raw native pointer or OpenGL object name crosses the OW boundary.
module_type GRAPHICS_SHADER:
  include NATIVE_LIFECYCLE
  fn create(vertexSource string, fragmentSource string) -> int
  fn bind(handle int) -> int
  fn set_vec4(handle int, name string, r float, g float, b float, a float) -> int
  fn set_mat4(handle int, name string, values array) -> int
  fn set_mat4_array(handle int, name string, matrices array) -> int
  fn set_int(handle int, name string, value int) -> int
  fn destroy(handle int) -> int
