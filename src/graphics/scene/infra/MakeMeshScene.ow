# A native OW functor depends only on the renderer contract.
# An application decides which shader/mesh instances to bind before rendering.
functor MakeMeshScene(Draw: GRAPHICS_RENDERER) -> GRAPHICS_MESH_SCENE:
  fn name() -> string:
    return: "scene"
  fn requires() -> array:
    return: ["renderer"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn render_frame(mesh int) -> int:
    if: Draw.clear(16, 23, 39) == 0
      return: 0
    return: Draw.draw_mesh(mesh)
