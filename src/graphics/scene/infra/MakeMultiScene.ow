# Renderer chosen by a typed native OW functor.
# No direct OpenGL calls and no ownership of texture/mesh/shader handles.
functor MakeMultiScene(Draw: GRAPHICS_RENDERER) -> GRAPHICS_MULTI_SCENE:
  fn name() -> string:
    return: "multi_scene"
  fn requires() -> array:
    return: ["renderer"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn begin_frame(red int, green int, blue int) -> int:
    return: Draw.clear(red, green, blue)
  fn draw_object(mesh int) -> int:
    return: Draw.draw_mesh(mesh)
