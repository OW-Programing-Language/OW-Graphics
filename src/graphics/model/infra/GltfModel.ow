# CPU-only glTF loader through the JVM RuntimeExtension; no GL context needed.
module Graphics.GltfModel: GRAPHICS_GLTF_MODEL
  fn name() -> string:
    return: "gltf"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn parse_gltf(contents string) -> array:
    return: extension("graphics.model.parse_gltf", contents)
  fn load_gltf(relativePath string) -> array:
    return: extension("graphics.model.load_gltf", relativePath)
