# CPU-only scene decoder through the Java RuntimeExtension. No OpenGL needed.
module Graphics.GltfScene: GRAPHICS_GLTF_SCENE
  fn name() -> string:
    return: "gltf_scene"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn parse_scene(contents string) -> array:
    return: extension("graphics.scene.parse_gltf", contents)
  fn load_scene(relativePath string) -> array:
    return: extension("graphics.scene.load_gltf", relativePath)
