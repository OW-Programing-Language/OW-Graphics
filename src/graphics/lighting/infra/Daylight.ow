# Small daylight preset: direction in world coordinates, ambient + diffuse.
# The user can supply different LIGHTING modules without native changes.
module Graphics.Daylight: GRAPHICS_LIGHTING
  fn name() -> string:
    return: "lighting"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn direction() -> array:
    return: [0.4, 0.7, 1.0]
  fn levels() -> array:
    return: [0.28, 0.72]
