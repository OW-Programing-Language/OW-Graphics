# Pure OW lighting preset: bright warm key, cooler fill and a point light.
# The GLSL shader decides the actual per-pixel Lambert + attenuation model.
module Graphics.StudioLights: GRAPHICS_LIGHT_RIG
  fn name() -> string:
    return: "light_rig"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn key_direction() -> array:
    return: [0.6, 0.9, 0.7]
  fn fill_direction() -> array:
    return: [0.0 - 0.9, 0.35, 0.0 - 0.5]
  fn point_position() -> array:
    return: [1.2, 1.5, 1.8]
  fn intensities() -> array:
    return: [0.55, 0.3, 0.6]
  fn ambient() -> array:
    return: [0.18, 0.18, 0.2]
