# GLFW/OpenGL are implementation details, hidden behind this flOW module.
module Graphics.OpenGLTexture: GRAPHICS_TEXTURE
  fn name() -> string:
    return: "texture"
  fn requires() -> array:
    return: ["window"]
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create_rgba8(width int, height int, pixels array) -> int:
    return: extension("graphics.texture.create_rgba8", width, height, pixels)
  fn load_image(relativePath string) -> int:
    return: extension("graphics.texture.load_image", relativePath)
  fn bind(handle int, slot int) -> int:
    return: extension("graphics.texture.bind", handle, slot)
  fn destroy(handle int) -> int:
    return: extension("graphics.texture.destroy", handle)
