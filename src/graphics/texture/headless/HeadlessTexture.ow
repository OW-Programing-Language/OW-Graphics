# Contract dummy for tests; does not emulate native memory or texture sampling.
module Graphics.HeadlessTexture: GRAPHICS_TEXTURE
  fn name() -> string:
    return: "texture"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn create_rgba8(width int, height int, pixels array) -> int:
    if: width < 1
      return: 0
    if: height < 1
      return: 0
    if: len(pixels) != width * height * 4
      return: 0
    return: 1
  fn bind(handle int, slot int) -> int:
    if: handle < 1
      return: 0
    if: slot < 0
      return: 0
    return: 1
  fn destroy(handle int) -> int:
    if: handle < 1
      return: 0
    return: 1
