# Pure OW swappable metallic-roughness presets.
module Graphics.MetallicRoughness: GRAPHICS_PBR_MATERIAL
  fn name() -> string:
    return: "pbr"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn base_color(name string) -> array:
    if: name == "gold"
      return: [1.0, 0.765, 0.336, 1.0]
    if: name == "ceramic"
      return: [0.3, 0.63, 0.9, 1.0]
    if: name == "plastic"
      return: [0.92, 0.32, 0.38, 1.0]
    call: assert(0 == 1, "unknown PBR preset")
    return: []
  fn factors(name string) -> array:
    if: name == "gold"
      return: [1.0, 0.28]
    if: name == "ceramic"
      return: [0.0, 0.38]
    if: name == "plastic"
      return: [0.0, 0.75]
    call: assert(0 == 1, "unknown PBR preset")
    return: []
