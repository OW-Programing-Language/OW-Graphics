# Swappable, typed material library. No native GPU ownership or global state.
module Graphics.StudioMaterials: GRAPHICS_MATERIAL_LIBRARY
  fn name() -> string:
    return: "materials"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn tint(name string) -> array:
    if: name == "copper"
      return: [0.98, 0.48, 0.25, 1.0]
    if: name == "azure"
      return: [0.20, 0.65, 0.97, 1.0]
    if: name == "stone"
      return: [0.75, 0.77, 0.82, 1.0]
    call: assert(0 == 1, "unknown studio material")
    return: []
  fn properties(name string) -> array:
    if: name == "copper"
      return: [0.22, 0.75, 0.55, 24.0]
    if: name == "azure"
      return: [0.20, 0.80, 0.80, 48.0]
    if: name == "stone"
      return: [0.32, 0.60, 0.12, 8.0]
    call: assert(0 == 1, "unknown studio material")
    return: []
